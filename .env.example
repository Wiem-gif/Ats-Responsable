# === Base de données (Supabase — utiliser l'URL du POOLER, port 6543) ===
DATABASE_URL="postgresql://postgres.your_project_ref:your_password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# === Stockage (Supabase Storage, compatible API S3) ===
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_BUCKET_NAME="cvs"
AWS_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"

# === IA (Groq — clé gratuite sur console.groq.com) ===
GROQ_API_KEY="your_groq_api_key"
OPENAI_MODEL="openai/gpt-oss-20b"

# === OCR (clé gratuite sur ocr.space/ocrapi/freekey) ===
OCR_SPACE_API_KEY="your_ocr_space_api_key"

# === Envoi d'email (compte Gmail dédié + mot de passe d'application) ===
GMAIL_USER="your_dedicated_gmail@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"
NOTIFICATION_EMAIL="recruiter_team_email@gmail.com"

# === Authentification ===
AUTH_SECRET="generate_a_long_random_string_here"

# === n8n (workflows W2 rappel J-1 et W3 relance) ===
CRON_SECRET="generate_another_random_string_here"

# === Mode démo (accélère les délais des workflows n8n pour la vidéo) ===
DEMO_MODE="true"

# === App ===
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"