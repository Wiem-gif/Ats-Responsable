# === Base de données ===
# Ex: Neon, Supabase, ou Postgres local
DATABASE_URL="postgresql://user:password@localhost:5432/database-name"

# === Stockage S3 (CV, portfolios) ===
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_BUCKET_NAME="ats-responsable-cv"
AWS_ENDPOINT="https://................storage.supabase.co/storage/v1/s3"

# === OCR ===
OCR_SPACE_API_KEY="phrase aléatoire"

# === IA ===
GROQ_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

GMAIL_USER="user.example@gmail.com"
GMAIL_APP_PASSWORD="......."

# === n8n (orchestration des workflows W1/W2/W3) ===
N8N_INGESTION_WEBHOOK_URL="https://your-n8n-instance.com/webhook/ingestion"
N8N_INTERVIEW_WEBHOOK_URL="https://your-n8n-instance.com/webhook/interview"



# === Mode démo (accélère les délais J-1 / 5 jours pour la vidéo de démo) ===
DEMO_MODE="true"

# === App ===
NEXT_PUBLIC_APP_URL="https://ats-responsable.vercel.app"
